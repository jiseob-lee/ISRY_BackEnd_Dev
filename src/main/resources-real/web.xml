    <listener>
        <listener-class>com.cleopatra.XBInitializer</listener-class>
    </listener>
    
	<filter>
		<filter-name>encodingFilter</filter-name>
		<filter-class>org.springframework.web.filter.CharacterEncodingFilter</filter-class>
		<init-param>
			<param-name>encoding</param-name>
			<param-value>utf-8</param-value>
		</init-param>
	</filter>
	<filter-mapping>
		<filter-name>encodingFilter</filter-name>
		<url-pattern>*.do</url-pattern>
	</filter-mapping>
    
	<filter>
		<filter-name>HTMLTagFilter</filter-name>
		<filter-class>egovframework.rte.ptl.mvc.filter.HTMLTagFilter</filter-class>
	</filter>
	<filter-mapping>
		<filter-name>HTMLTagFilter</filter-name>
		<url-pattern>*.do</url-pattern>
	</filter-mapping>


    <filter>
        <filter-name>sessionTimeoutFilter</filter-name>
        <filter-class>isry.itgcms.sysmgmt.util.SessionTimeoutCookieFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>sessionTimeoutFilter</filter-name>
        <url-pattern>*.do</url-pattern>
    </filter-mapping>


    <!-- K-Depense R7 키보드 보안솔루션 필터적용-->
	<filter>
	    <description>K-Defense End-to-End Decryption Filter</description>
	    <filter-name>E2EFilter</filter-name>
	    <filter-class>kr.co.kings.e2e.filters.E2EFilter</filter-class>
	    <init-param>
	        <param-name>RequestEncoding</param-name>
	        <param-value>UTF-8</param-value>
	    </init-param>
	    <init-param>
	        <param-name>PrivateKeyPathRelative</param-name>
	        <param-value>/WEB-INF/Kings/E2E/Private.Encrypted.key</param-value>
	    </init-param>
	    <init-param>
	        <param-name>KeyEncryptionType</param-name>
	        <param-value>1</param-value>
	    </init-param>
	</filter>
	
	<!-- E2E 및 가상 키패드 필터 맵핑 -->
	<!-- 중요! E2E 필터 -> vKeypad 필터 순으로 동작해야합니다. -->
	<filter-mapping>
	  <filter-name>E2EFilter</filter-name>
	  <url-pattern>*.jsp</url-pattern>
	  <url-pattern>*.do</url-pattern>
	</filter-mapping>
	
    <!-- 2023-01-06 EzFilter 개인정보필터  -->
    <filter>
		<display-name>EzFilter</display-name>
		<filter-name>EzFilter</filter-name>
		<filter-class>com.easycerti.psm.log.generator.filter.EzFilter</filter-class>
		<init-param><param-name>log.server.ip</param-name><param-value>10.188.131.201</param-value></init-param>
		<init-param><param-name>log.server.port</param-name><param-value>46004</param-value></init-param>
		<init-param><param-name>log.server.sub.ip</param-name><param-value>10.188.131.201</param-value></init-param>
		<init-param><param-name>log.server.sub.port</param-name><param-value>46005</param-value></init-param>
		<init-param><param-name>command.server.port</param-name><param-value>56091</param-value></init-param>
		<init-param><param-name>log.file.name</param-name><param-value>EzMon_LOG_13</param-value></init-param>
		<init-param><param-name>system.code</param-name><param-value>13</param-value></init-param>
		<init-param><param-name>print.session.info</param-name><param-value>false</param-value></init-param>
		<init-param><param-name>req.id</param-name><param-value>userId</param-value></init-param>
		<init-param><param-name>req.id.cut</param-name><param-value></param-value></init-param>
		<init-param><param-name>socket.timeout</param-name><param-value>1500</param-value></init-param>
		<init-param><param-name>log.limit.size</param-name><param-value>10</param-value></init-param>
		<init-param><param-name>log.level</param-name><param-value>5</param-value></init-param>
		<init-param><param-name>log.file.write</param-name><param-value>false</param-value></init-param>
		<init-param><param-name>file.log.path</param-name><param-value>/tmp/</param-value></init-param>
		<init-param><param-name>exclude.url</param-name><param-value></param-value></init-param>
		<init-param><param-name>max.queue.cnt</param-name><param-value>1000</param-value></init-param>
		<init-param><param-name>max.thread.cnt</param-name><param-value>10</param-value></init-param>
		<init-param><param-name>monitor.term</param-name><param-value>30000</param-value></init-param>
	</filter>
	<filter-mapping>
		<filter-name>EzFilter</filter-name>
		<url-pattern>/*</url-pattern>
    </filter-mapping>
	<listener>
	    <listener-class>com.easycerti.psm.log.generator.filter.EzContextListener</listener-class>
	</listener>
    <!-- // 2023-01-06 EzFilter 개인정보필터  -->


