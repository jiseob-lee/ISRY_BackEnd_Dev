    <insert id="insertStmtOfRs" parameterType="HashMap">
    /**
	*		insertStmtOfRs : isry.couns.taskwksprt.taskwkandatdmng.mapper.StmtOfRsMapper : 사유서 목록 등록
	*/
	    INSERT	INTO
				AYC320		/** 사이버상담사유서 **/
				(
						STOFRE_SN
					,	WRTR_ID
					,	WRT_YMD
					,	STOFRE_TTL_NM
					,	STOFRE_CN
					,	REG_YMD
					,	APRV_STTS_SE_CD
				<if test='bbscttAtfino != null and bbscttAtfino != ""'>
					,	ATFINO
				</if>
					,	FRST_RGTR_ID
					,	FRST_REG_DT
					,	LAST_MDFR_ID
					,	LAST_MDFCN_DT
				)		
		VALUES
				(
						AYC320_SQ01.NEXTVAL
					,	#{loginId}
					,	REPLACE(#{wrtYmd}, '-', '')
					,	#{stofreTtlNm}
					,	#{stofreCn}
					,	TO_CHAR(SYSDATE,'YYYYMMDD')
					,	'0'				/** 대기 **/
				<if test='bbscttAtfino != null and bbscttAtfino != ""'>
					,	#{bbscttAtfino}
				</if>
					,	#{loginId}
					,	SYSDATE
					,	#{loginId}
					,	SYSDATE
				)
    </insert>
    <update id="deleteStmtOfRs" parameterType="HashMap">
    /**
	*		deleteStmtOfRs : isry.couns.taskwksprt.taskwkandatdmng.mapper.StmtOfRsMapper : 사유서 목록 삭제
	*/
	    UPDATE
	    		AYC320		AA		/** 사이버상담사유서 **/
	    SET
	    		AA.DEL_YN	=	'Y'
	    	,	AA.LAST_MDFR_ID	=	#{loginId}
			,	AA.LAST_MDFCN_DT	=	SYSDATE
	    WHERE	1=1
	    	AND	AA.STOFRE_SN	=	#{stofreSn}
    </update>

</mapper>