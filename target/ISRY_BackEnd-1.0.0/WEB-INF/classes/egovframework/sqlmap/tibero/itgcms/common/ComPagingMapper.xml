         ) AS ROW_NUM,
		COUNT(*) OVER() AS TOT_CNT,
         ]]>
	</sql>

	<sql id="pageRowNumWhere">
		<choose>
			<when test='FIRST_RECORD_INDEX != null and LAST_RECORD_INDEX != null'>
		         <![CDATA[		       
		        )_T WHERE ROW_NUM > #{FIRST_RECORD_INDEX} AND ROW_NUM <=  #{LAST_RECORD_INDEX}
		         ]]>
			</when>
			<otherwise>
				 <![CDATA[
		        )_T
		         ]]>
			</otherwise>
		</choose>
	</sql>
    
