<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper   PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="ComPagingMapper">
    
    <!-- offset 방식(권장)-->
    <sql id="pageHeader">
    <![CDATA[
          SELECT COUNT(*) OVER() AS TOT_CNT,         
         ]]>
    </sql>
    
    <sql id="pageOffset">
       <if test='FIRST_RECORD_INDEX != null and PAGE_ROW_COUNT != null'>
       OFFSET #{FIRST_RECORD_INDEX} ROWS FETCH NEXT #{PAGE_ROW_COUNT} ROWS ONLY
       </if>        
    </sql>
    
    <!-- rownum 방식-->    
