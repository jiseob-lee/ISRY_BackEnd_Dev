        </if>  
    </sql>
    
    <!-- 기관및종사자현황 > 종사자현황 부가정보 - isry.drmgs.stdnt.mapper.CnterPreconEnfsnMapper.selectEnfsnPrvateCerti 종사자 자격증현황 -->
    <sql id="cnterPreconEnfsnListGropuAuthrt">
        AND A.CNTER_INST_NO IN
        <foreach collection="INST_NOS" item="item" open="("
            separator="," close=")">
            #{item}
        </foreach>
        <if test=" GROUP_AUTHRT_SE_CD.SUBSTR(1,3) eq '40'.toString() ">
            /*종사자*/
