    <!-- 업무공통 -> 집단서비스등록 (isry.itgcm.casemng.caseunity.SrvcGrPvsnMapper.selectSrvcGrPvsnList(서비스집단제공목록조회)) -->
    <sql id="srvcGrPvsnGropuAuthrt">
        AND T1.TKCG_INST_NO IN
        <foreach collection="INST_NOS" item="item" open="("
            separator="," close=")">
            #{item}
        </foreach>
        <if test=" GROUP_AUTHRT_SE_CD.SUBSTR(1,3) eq '40'.toString() ">
            /*종사자*/
            /* 2023-03-24 : 집단 계획 및 실행을 등록시 서비스실행사업에 속한 대상자가 모두나옴
                             내일이룸, 이주배경의 예)
                             내일이룸학교의 서비스실행사업은 내일이룸학교 단일로써 위탁기관들이 내일이름 학교 서비스실행사업을 기준으로 자원제공서비스를 등록하기 때문에
                             자원제공서비스 기관로 처리하지 않으면 다른 기관의 대상자까지 끌어 오는 현상이 발생
                             기관기준으로 권한 적용
            */
        </if>  
    </sql>    
    
    <!-- 성과일괄등록 -->
    <sql id="outcGropuAuthrt">
        AND (SELECT X.INST_NO
                           FROM SAA000 X
                              , SEB150 Y
                          WHERE X.INST_NO        = Y.PIC_INST_NO
                            AND Y.PCHPRS_YN      = 'Y' 
                            AND Y.CASE_MNG_NO    = T1.CASE_MNG_NO
                            AND Y.CASE_MNG_ODRNO = T1.CASE_MNG_ODRNO) IN
        <foreach collection="INST_NOS" item="item" open="("
            separator="," close=")">
            #{item}
        </foreach>
    </sql>
    
    <!-- 업무공통 -> isry.itgcm.bizcmmns.cmmns.mapper.CaseMtgMapper.selectGrCaseMtgList(집단 사례회의목록) -->
