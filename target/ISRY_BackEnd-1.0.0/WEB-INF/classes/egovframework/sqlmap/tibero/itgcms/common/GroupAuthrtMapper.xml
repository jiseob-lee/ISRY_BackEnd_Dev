    </sql>
    
    <!-- 통계현황관리 - 사례관리기본통계(isry.itgcm.unitystats.mapper.UnitystatsMapper - selectCaseMngBassStatsList[사례관리기본통계]) -->
    <sql id="caseMngBassStatsGropuAuthrt">
        AND F0.PIC_INST_NO IN
        <foreach collection="INST_NOS" item="item" open="("
