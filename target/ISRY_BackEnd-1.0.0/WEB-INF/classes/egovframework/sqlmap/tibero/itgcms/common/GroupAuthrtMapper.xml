    <!-- 통계현황관리 - isry.itgcm.unitystats.mapper.UnitystatsMapper - selectEmrgIntrvnMngStatsList[긴급구조통계(지자체안정망,상담복지센터)] -->
    <sql id="emrgIntrvnMngStatsGropuAuthrt">
