<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper   PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">


<!-- 
 수정
/*20230126_강화영_권한 쿼리 시작*/
/*20230203_유치훈_권한 쿼리 최종변경사항 수정*/

 -->

<mapper namespace="GroupAuthrtMapper">
    
    <!-- 업무공통 -> 발굴대상자조회팝업 (isry.itgcm.bizcmmns.cmmns.TrprInfoMapper.selectTrprInfoList(대상자정보 목록조회)) -->
    <sql id="trprinfoGropuAuthrt">
        AND T1.RCPT_INST_NO IN
        <foreach collection="INST_NOS" item="item" open="("
            separator="," close=")">
            #{item}
        </foreach>
        <if test=" GROUP_AUTHRT_SE_CD.SUBSTR(1,3) eq '40'.toString() ">
            /*종사자 trprinfoGropuAuthrt*/
            /*
                목록은 권한적용을 하되 작성자 레벨까지는 하지 말고 소속 기관까지만 레벨로
            */
        </if>  
    </sql>

    <!-- 업무공통 -> 발굴관리 - (발굴상담, 긴급구조) (isry.itgcm.casemng.uneart.DscsnUneartMapper.selectUneartDscsnList(발굴목록조회)/selectEmrgRescList(긴급구조목록조회) -->
    <sql id="uneartGropuAuthrt">
        AND T21.CONSTT_INST_NO IN
        <foreach collection="INST_NOS" item="item" open="("
            separator="," close=")">
            #{item}
        </foreach>
        <if test=" GROUP_AUTHRT_SE_CD.SUBSTR(1,3) eq '40'.toString() ">
            /*종사자*/
            AND T21.CONSTT_NO = #{ENFSN_NO}
        </if> 
    </sql>    
    
    <!-- 업무공통 -> 발굴관리 - (아웃리치) (isry.itgcm.casemng.uneart.DscsnUneartMapper.selectOutrctList(아웃리치 목록조)) -->    
    <sql id="outrctGropuAuthrt">
        AND T21.RGTR_INST_NO IN
        <foreach collection="INST_NOS" item="item" open="("
            separator="," close=")">
            #{item}
        </foreach>
        <if test=" GROUP_AUTHRT_SE_CD.SUBSTR(1,3) eq '40'.toString() ">
            /*종사자*/
            /* 2023-06-22 모든 담당자가 아웃리치 목록 조회 가능하도록 변경, 아웃리치 실적 및 화면상 보이는 발굴 조치 대상자에 대한 정보 확인 가능하도록*/
        </if>   
    </sql> 
       
    <!-- 업무공통 -> 미등록사례관리(isry.itgcm.casemng.uneart.mapper.UnRegCaseMapper.selectUnRegCaseList), 미등록사례관리목록조회 -->    
    <sql id="unRegCaseGropuAuthrt">
        AND (A.PIC_INST_NO IN
        <foreach collection="INST_NOS" item="item" open="("
            separator="," close=")">
            #{item}
        </foreach>
        <if test=" GROUP_AUTHRT_SE_CD.SUBSTR(1,3) eq '40'.toString() ">
            /*종사자*/
            AND #{ENFSN_NO} IN (SELECT UNREGI_CASE_PIC_NO FROM SED102 WHERE UNREGI_CASE_NO = A.UNREGI_CASE_NO)
        </if>  
        )
    </sql>    
    
    <!-- 업무공통 -> 발굴관리 - 연계접수목록(isry.itgcm.linkmng.outsd.mapper.LinkTrprRqstMapper.selectLinkTrprRcptList(연계접수목록)) -->
    <sql id="linkTrprRcptGropuAuthrt">
        AND ((B.RCPT_INST_NO IN
        <foreach collection="INST_NOS" item="item" open="("
            separator="," close=")">
            #{item}
        </foreach>
        ) or (B.RRQST_RCPT_INST_NO IN
        <foreach collection="INST_NOS" item="item" open="("
            separator="," close=")">
            #{item}
        </foreach>
        ))
        <if test=" GROUP_AUTHRT_SE_CD.SUBSTR(1,3) eq '40'.toString() ">
            /*종사자*/
            AND ((B.CLR_NO IS NULL OR B.CLR_NO = '0') OR (B.CLR_NO IS NOT NULL AND B.CLR_NO = #{ENFSN_NO}))
        </if>  
    </sql>
    
    <!-- 업무공통 -> 사례관리 - 사례등록관리(isry.itgcm.casemng.caseunity.mapper.CaseRegMapper.selectCaseinqList) -->
    <sql id="caseinqGropuAuthrt">
        <![CDATA[
        AND EXISTS (SELECT 1 FROM SEB100 ZZ, SEB150 YY
            WHERE T1.CASE_MNG_NO = ZZ.CASE_MNG_NO 
            AND T1.CASE_MNG_ODRNO = ZZ.CASE_MNG_ODRNO
            AND ZZ.CASE_MNG_NO = YY.CASE_MNG_NO 
            AND ZZ.CASE_MNG_ODRNO = YY.CASE_MNG_ODRNO
            AND YY.PIC_DSGN_YMD <= TO_CHAR(SYSDATE,'YYYYMMDD')
            AND YY.PIC_INST_NO IN             
        ]]>
            <foreach collection="INST_NOS" item="item" open="("
                separator="," close=")">
                #{item}
            </foreach>
            ) 
        <if test=" GROUP_AUTHRT_SE_CD.SUBSTR(1,3) eq '40'.toString() ">
            /*종사자*/
            AND T1.ENFSN_NO LIKE '%'||#{ENFSN_NO}||'%'
        </if>  
    </sql>
    
    <!-- 업무공통 -> 사례관리 - 사례등록관리(isry.itgcm.casemng.caseunity.mapper.CaseRegMapper.selectCaseinqList) -->
    <sql id="caseinqGropuListAuthrt">
        <choose>
            <when test="GROUP_AUTHRT_SE_CD lt 300">
            </when>
            <when test="GROUP_AUTHRT_SE_CD.SUBSTR(1,3) eq '40'.toString()">
            <![CDATA[
	        AND EXISTS (SELECT 1 FROM SEB150 YY
	            WHERE 1=1
	            AND T1.CASE_MNG_NO = YY.CASE_MNG_NO 
	            AND T1.CASE_MNG_ODRNO = YY.CASE_MNG_ODRNO
	            AND YY.PIC_DSGN_YMD <= TO_CHAR(SYSDATE,'YYYYMMDD')
                AND YY.CASE_PIC_NO = #{ENFSN_NO}
            )
	        ]]>
            </when>
            <otherwise>
            <![CDATA[
            AND (T1.CASE_MNG_NO, T1.CASE_MNG_ODRNO) 
                IN (SELECT YY.CASE_MNG_NO,YY.CASE_MNG_ODRNO  
                    FROM SEB150 YY
	                WHERE 1=1
	                AND YY.PIC_INST_NO IN             
	            ]]>
	                <foreach collection="INST_NOS" item="item" open="("
	                    separator="," close=")">
	                    #{item}
	                </foreach>
	        )
            </otherwise>
        
        </choose>
    </sql>
    
    <!-- 사례관리 - 직업역량강화(isry.drmgs.casereg.mapper.DrmgsCaseRegMapper.selectOccpAbilitInsertList) -->
    <sql id="occpAbilitGropuAuthrt">
        AND T4.PIC_INST_NO IN
        <foreach collection="INST_NOS" item="item" open="("
            separator="," close=")">
            #{item}
        </foreach>
        <if test=" GROUP_AUTHRT_SE_CD.SUBSTR(1,3) eq '40'.toString() ">
            /*종사자*/
            AND T4.CASE_PIC_NO = #{ENFSN_NO}
        </if>  
    </sql>
    
    <!-- 사례관리 - 연계의뢰(isry.itgcm.linkmng.outsd.mapper.LinkTrprRqstMapper.selectLinkTrprRqstList) -->
    <sql id="linkTrprRqstGropuAuthrt">
        AND AA.RQST_INST_NO IN
        <foreach collection="INST_NOS" item="item" open="("
            separator="," close=")">
            #{item}
        </foreach>
        <if test=" GROUP_AUTHRT_SE_CD.SUBSTR(1,3) eq '40'.toString() ">
            /*종사자*/
            AND AA.CLINT_NO = #{ENFSN_NO}
        </if>  
    </sql>
    
    <!-- 통계현황관리 - 발굴관리통계(isry.itgcm.unitystats.mapper.UnitystatsMapper - selectUneartMngStatsList[발굴관리통계]) -->
    <sql id="uneartMngStatsGropuAuthrt">
        AND A.RCPT_INST_NO IN
        <foreach collection="INST_NOS" item="item" open="("
            separator="," close=")">
            #{item}
        </foreach>
        <if test=" GROUP_AUTHRT_SE_CD.SUBSTR(1,3) eq '40'.toString() ">
            /*종사자*/
            AND A.RCPT_PIC_NO = #{ENFSN_NO}
