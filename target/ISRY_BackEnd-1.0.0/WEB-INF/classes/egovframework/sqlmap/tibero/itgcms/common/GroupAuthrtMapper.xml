        </foreach>
    </sql>
    
    <!-- 기관및종사자현황 > 종사자현황 - isry.drmgs.stdnt.mapper.CnterPreconEnfsnMapper.selectEnfsnInfo 종사자현황 -->
    <sql id="cnterPreconEnfsnGropuAuthrt">
