    <!-- 통계현황관리 - isry.itgcm.unitystats.mapper.UnitystatsMapper - selectDscsnOutrcMngStatsList[아웃리치통계(쉼터)] -->
    <sql id="dscsnOutrcMngStatsGropuAuthrt">
        AND A1.RGTR_INST_NO IN
        <foreach collection="INST_NOS" item="item" open="("
