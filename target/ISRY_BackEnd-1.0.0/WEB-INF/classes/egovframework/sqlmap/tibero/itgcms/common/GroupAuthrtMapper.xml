    <!-- isry.drmgs.actvt.mapper.ActvtSafetyMuaiasMapper.selectActvtSafetyMuaiasList 청소년활동안전공제회관리 -->
    <sql id="actvtSafetyMuaiasGropuAuthrt">
        AND C.PIC_INST_NO IN
        <foreach collection="INST_NOS" item="item" open="("
            separator="," close=")">
            #{item}
        </foreach>
    </sql>

    <!-- isry.drmgs.stdnt.mapper.YouthLifeRecodeMapper.selectYouthLifeRecodeMainList - 청소년생활기록부관리 -->
    <sql id="youthLifeRecodeMainGropuAuthrt">
        AND T5.PIC_INST_NO IN
        <foreach collection="INST_NOS" item="item" open="("
            separator="," close=")">
            #{item}
        </foreach>
    </sql>
    
    <!-- 업무공통 -> 복지부연계의뢰접수 (isry.itgcm.linkmng.outsd.mapper.LinkMohwSrvcRqstMapper.selectMohwSrvcRqstRcptList(복지부연계접수목록)) -->
    <sql id="linkMohwSrvcRqstRcptGropuAuthrt">
        AND T1.RQST_PRCS_SRV_INST_ID IN
        <foreach collection="INST_NOS" item="item" open="("
            separator="," close=")">
            #{item}
        </foreach>
        <if test=" GROUP_AUTHRT_SE_CD.SUBSTR(1,3) eq '40'.toString() ">
            /*종사자*/
            /* 2023-03-07 : 등록한 해당종사자를 특정할수 있는 컬럼이 없기때문에 기관기준으로만 권한적용을 함*/
        </if>  
    </sql>    
    <!-- 업무공통 -> 복지부연계의뢰요청 (isry.itgcm.linkmng.outsd.mapper.LinkMohwSrvcRqstMapper.selectMohwSrvcRqstDmndList(복지부연계요청목록)) -->
    <sql id="linkMohwSrvcRqstDmndGropuAuthrt">
        AND T1.RQST_SRV_INST_ID IN
        <foreach collection="INST_NOS" item="item" open="("
            separator="," close=")">
            #{item}
        </foreach>
        <if test=" GROUP_AUTHRT_SE_CD.SUBSTR(1,3) eq '40'.toString() ">
