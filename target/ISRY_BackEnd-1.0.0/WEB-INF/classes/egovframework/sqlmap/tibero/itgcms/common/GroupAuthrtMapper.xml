    </sql>
    
    <!-- 통계현황관리 - isry.itgcm.unitystats.mapper.UnitystatsMapper - selectTlphonDscsnMngStatsList[1388전화상담통계(상담복지센터)] -->
    <sql id="tlphonDscsnMngStatsGropuAuthrt">
