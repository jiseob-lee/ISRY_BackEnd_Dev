    </sql>
    
    <!-- 사례관리 - isry.drmgs.stats.mapper.StatsDrmgsMapper.selectMeditationStats 학업숙려제통계 -->
    <sql id="meditationStatsGropuAuthrt">
        AND D.PIC_INST_NO IN
