        </foreach>
        <if test=" GROUP_AUTHRT_SE_CD.SUBSTR(1,3) eq '40'.toString() ">
            /*종사자 selectGrCaseMtgList*/
            AND T3.PIC_NO = #{ENFSN_NO}
        </if>  
    </sql>   
     
    <!-- 업무공통 -> isry.itgcm.bizcmmns.cmmns.CaseTrprInfoMapper.selectCaseTrprInfoList(사례대상자정보팝업 목록조회) -->
    <sql id="caseTrprInfoGropuAuthrt">
