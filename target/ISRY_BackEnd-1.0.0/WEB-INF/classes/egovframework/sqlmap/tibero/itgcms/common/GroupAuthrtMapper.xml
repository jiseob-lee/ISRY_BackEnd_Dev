        </if>  
    </sql>
    
    <!-- 업무공통 -> 병역의무자 상담지원의뢰 (isry.itgcm.linkmng.outsd.mapper.LinkMmaRcptJobMapper.selectLinkMmaList(병무청상담지원의뢰접수목록)) -->
    <sql id="linkMmaSrvcRqstGropuAuthrt">
        AND T1.INST_NO IN
        <foreach collection="INST_NOS" item="item" open="("
