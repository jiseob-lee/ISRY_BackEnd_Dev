<mapper namespace="RegnsGroupAuthrtMapper">

    <!-- 지자체안전망 -> 긴급대응지원기구 - 공통) -->
    <sql id="regnsBasicGropuAuthrt">
        AND A.INST_NO IN
        <foreach collection="INST_NOS" item="item" open="("
            separator="," close=")">
            #{item}
        </foreach>
        <if test=" GROUP_AUTHRT_SE_CD.SUBSTR(1,3) eq '40'.toString() ">
            /*종사자*/
            AND A.PIC_NO = #{ENFSN_NO}
        </if>  
    </sql>

</mapper>