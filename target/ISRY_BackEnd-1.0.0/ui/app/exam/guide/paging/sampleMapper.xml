<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="isry.itgcm.casemng.uneart.mapper.TrprInqMapper">
    
    <!-- 기본구조  -->
    <!-- 대상자 목록조회 -->
    <select id="selectSample" parameterType="HashMap" resultType="HashMap">
                
        <!-- 페이지 인덱서 헤더 -->
        <include refid="ComPagingMapper.pageHeader" />      
        <!-- 페이지 인덱서 실행 쿼리 SELECT 이후-->
                      COLUMN1
                     ,COLUMN2                
                FROM TEST
                WHERE 1=1
             ORDER BY T.FRST_REG_DT DESC, T.TRPR_INFO_NO
      <!-- 페이지 인덱서 OFFSET 조건 -->
      <include refid="ComPagingMapper.pageOffset"/>
    </select>
    
    
    <!-- 구문에 DISTINCT 포함되어있을경우  -->  
    <select id="selectSample" parameterType="HashMap" resultType="HashMap">
                
        <!-- 페이지 인덱서 헤더 -->            
        <include refid="ComPagingMapper.pageDistinctHeader"/>
                  
              SELECT  DISTINCT 
                      COUNT(*) OVER() AS TOT_CNT --공통추가
                     ,COLUMN1
                     ,COLUMN2                
                FROM TEST
                WHERE 1=1
             ORDER BY T.FRST_REG_DT DESC, T.TRPR_INFO_NO
      <!-- 페이지 인덱서 OFFSET 조건 -->
      <include refid="ComPagingMapper.pageDistinctOffset"/>
    </select>