    <select id="selectOvtiWorkEtxpyAplyList1" parameterType = "HashMap" resultType="HashMap">
    
    /*SQL-ID : isry.couns.taskwksprt.etxpyaplyandinq.mapper.OvtiWorkEtxpyAplyMapper.selectOvtiWorkEtxpyAplyList1 
             : 주간시간외수당 LIST */
    WITH ZZ AS
    (
        SELECT
                #{YYYYMM}        AS      YYYYMM
                , #{USER_ID}       AS      USER_ID
        FROM
                DUAL
    )
    ,   Z1  AS 
    (
	    SELECT
	            T5.USER_ID                  
	            , T4.FLNM_ENCPT             AS      FLNM
	            , T2.WORK_YMD               
	            , CASE
	              WHEN    T3.BGNG_HR   =   '03:30'    THEN    FLOOR((T1.CHTT_END_DT - to_date((T2.WORK_YMD || replace(T3.END_HR,':','') || '00'), 'YYYY-MM-DD HH24MISS')) * 24 * 60)
	              WHEN    T3.BGNG_HR   =   '07:00'    THEN    FLOOR((T1.CHTT_END_DT - to_date((T2.WORK_YMD || replace(T3.END_HR,':','') || '00'), 'YYYY-MM-DD HH24MISS')) * 24 * 60)
	              WHEN    T3.BGNG_HR   =   '10:30'    THEN    FLOOR((T1.CHTT_END_DT - to_date((T2.WORK_YMD || replace(T3.END_HR,':','') || '00'), 'YYYY-MM-DD HH24MISS')) * 24 * 60)
	              WHEN    T3.BGNG_HR   =   '14:00'    THEN    FLOOR((T1.CHTT_END_DT - to_date((T2.WORK_YMD || replace(T3.END_HR,':','') || '00'), 'YYYY-MM-DD HH24MISS')) * 24 * 60)
	              WHEN    T3.BGNG_HR   =   '17:30'    THEN    CASE
	                                                                               WHEN    FLOOR((T1.CHTT_END_DT - to_date((T2.WORK_YMD || replace(T3.END_HR,':','') || '00'), 'YYYY-MM-DD HH24MISS')) * 24 * 60) > 31 THEN    30
	                                                                               ELSE    FLOOR((T1.CHTT_END_DT - to_date((T2.WORK_YMD || replace(T3.END_HR,':','') || '00'), 'YYYY-MM-DD HH24MISS')) * 24 * 60)
	                                                                               END
	              ELSE    0
	              END                       AS  WTIME
	            , to_char(to_date((T2.WORK_YMD || replace(T3.BGNG_HR,':','') || '00'), 'YYYY-MM-DD HH24MISS'), 'YYYY-MM-DD AM HH24:MI:SS')          AS      WORK_BGNG_DT
	            , to_char(T1.CHTT_END_DT, 'YYYY-MM-DD AM HH24:MI:SS')                                                                               AS      CHTT_END_DT
		FROM    
		        ZZ
	            , AYB200      T1          /* 채팅이력 */
	            , AYC100    T2          /* 근무배정표_일별 */
	            , AYC110    T3          /* 근무배정표_월별 */
	            , SCA100    T4          /* 종사자 테이블 */
	            , SAA200    T5          /* 사용자 테이블 */
		WHERE   1=1
		AND     T3.BIZ_PLAN_MNG_NO                              =                       T2.BIZ_PLAN_MNG_NO
		AND     T2.WORK_YMD                                     =                       T1.OVTIME_WORK_YMD
		AND     T2.USER_ID                                      =                       T1.CNSLTNT_ID
		AND     T5.ENFSN_NO                                     =                       T4.ENFSN_NO
		AND     T5.USER_ID                                      =                       T1.CNSLTNT_ID
		AND     T1.CNSLTNT_ID                                   =                       ZZ.USER_ID
		AND     substr(T1.OVTIME_WORK_YMD, 0, 6)                =                       ZZ.YYYYMM
		AND     T1.OVTIME_WORK_YMD IS NOT NULL
    )
    
    SELECT  
            Z1.USER_ID
        ,   Z1.FLNM
        ,   Z1.WORK_YMD
        ,   Z1.WTIME                                                                     AS  EXCESS_WORK_HR
        ,   Z1.WORK_BGNG_DT
        ,   Z1.CHTT_END_DT
        ,   SUM(Z1.WTIME) OVER()                                                         AS  SSUM
        ,   TRUNC(SUM(Z1.WTIME) OVER(), -1)                                              AS  RCGNTN_HR
        ,   SUM(Z1.WTIME /10 * FF.WIK_OVTIME_UNTPC_AMT) OVER()                           AS  AAMT
        ,   TRUNC(TRUNC(SUM(Z1.WTIME) OVER(), -1) / 10 * FF.WIK_OVTIME_UNTPC_AMT, -1)  AS  RCGNTN_AMT
    FROM
            Z1
    INNER JOIN
            AYC380      FF      /* 근무수당단가관리 */    
    ON      1=1
        AND FF.CRTR_YR      =       SUBSTR(Z1.WORK_YMD, 1, 4)
    WHERE   1=1
    AND     Z1.WTIME    !=  0
    </select>

