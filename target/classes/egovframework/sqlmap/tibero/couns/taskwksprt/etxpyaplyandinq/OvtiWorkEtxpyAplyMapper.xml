    <select id="selectOvtiWorkEtxpyAplyList2" parameterType="HashMap" resultType="HashMap">
    WITH ZZ AS
	(
	    SELECT
               #{YYYYMM}        AS      YYYYMM
               , #{USER_ID}       AS      USER_ID
	    FROM
               DUAL
	)
	,   Z1      AS
	(
	    SELECT
	                T5.USER_ID              
	                , T4.FLNM_ENCPT         AS      FLNM
	                , T2.WORK_YMD           
	                , CASE
	                  WHEN    T3.BGNG_HR   =   '20:30'    THEN    FLOOR((T1.CHTT_END_DT - (to_date((T2.WORK_YMD || replace(T3.END_HR,':','') || '00'), 'YYYY-MM-DD HH24MISS')+1)) * 24 * 60)
	                  WHEN    T3.BGNG_HR   =   '00:00'    THEN    FLOOR((T1.CHTT_END_DT - to_date((T2.WORK_YMD || replace(T3.END_HR,':','') || '00'), 'YYYY-MM-DD HH24MISS')) * 24 * 60)
	                  WHEN    T3.BGNG_HR   =   '20:00'    THEN    FLOOR((T1.CHTT_END_DT - (to_date((T2.WORK_YMD || replace(T3.END_HR,':','') || '00'), 'YYYY-MM-DD HH24MISS')+1)) * 24 * 60)
	                  WHEN    T3.BGNG_HR   =   '17:30'    THEN    CASE
	                                                                                   WHEN    FLOOR((T1.CHTT_END_DT - to_date((T2.WORK_YMD || replace(T3.END_HR,':','') || '00'), 'YYYY-MM-DD HH24MISS')) * 24 * 60) > 31 
	                                                                                        THEN    FLOOR((T1.CHTT_END_DT - to_date((T2.WORK_YMD || replace(T3.END_HR,':','') || '00'), 'YYYY-MM-DD HH24MISS')) * 24 * 60) -30
	                                                                                   ELSE     0
	                                                                                   END
	                  ELSE    0
	                  END                   AS  WTIME
	                , to_char(to_date((T2.WORK_YMD || replace(T3.BGNG_HR,':','') || '00'), 'YYYY-MM-DD HH24MISS'), 'YYYY-MM-DD AM HH24:MI:SS')          AS          WORK_BGNG_DT
	                , to_char(T1.CHTT_END_DT, 'YYYY-MM-DD AM HH24:MI:SS')           AS      CHTT_END_DT
	    FROM    
	                ZZ
	                , AYB200    T1          /* 채팅이력 */
	                , AYC100    T2          /* 근무배정표_일별 */
	                , AYC110    T3          /* 근무배정표_월별 */
	                , SCA100    T4          /* 종사자 테이블 */
	                , SAA200    T5          /* 사용자 테이블 */
	    WHERE 1=1
	    AND     T3.BIZ_PLAN_MNG_NO                             =                       T2.BIZ_PLAN_MNG_NO
	    AND     T2.WORK_YMD                                    =                       T1.OVTIME_WORK_YMD
	    AND     T2.USER_ID                                     =                       T1.CNSLTNT_ID
	    AND     T5.ENFSN_NO                                    =                       T4.ENFSN_NO
	    AND     T5.USER_ID                                     =                       T1.CNSLTNT_ID
	    AND     T1.CNSLTNT_ID                                  =                       ZZ.USER_ID
	    AND     substr(T1.OVTIME_WORK_YMD, 0, 6)               =                       ZZ.YYYYMM
	    AND     T1.OVTIME_WORK_YMD IS NOT NULL
	)
	
	SELECT
           Z1.USER_ID
           ,   Z1.FLNM
           ,   Z1.WORK_YMD
           ,   Z1.WTIME                                                                     AS  EXCESS_WORK_HR
           ,   Z1.WORK_BGNG_DT                   
           ,   Z1.CHTT_END_DT
           ,   SUM(Z1.WTIME) OVER()                                                         AS  SSUM
           ,   TRUNC(SUM(Z1.WTIME) OVER(), -1)                                              AS  RCGNTN_HR
           ,   SUM(Z1.WTIME / 10 * FF.NIGHT_OVTIME_UNTPC_AMT) OVER()                        AS  AAMT
           ,   TRUNC(TRUNC(SUM(Z1.WTIME) OVER(), -1) / 10 * FF.NIGHT_OVTIME_UNTPC_AMT, -1)  AS  RCGNTN_AMT
	FROM
	            Z1
	INNER JOIN
	            AYC380      FF          /* 근무수당단가관리 */
	ON      1=1
	AND     FF.CRTR_YR      =       SUBSTR(Z1.WORK_YMD, 1, 4)
	WHERE 1=1
    AND     Z1.WTIME    !=  0
    </select>
    
    <select id="selectOvtiWorkEtxpyAplyList3" parameterType="HashMap" resultType="HashMap">
    WITH    ZZ  AS
    (
            SELECT
                    SUBSTR(#{YYYYMM}, 1, 4)     AS  YYYY
                    , #{YYYYMM}                 AS  YYYYMM
                    , #{USER_ID}                AS  USER_ID
            FROM
                    DUAL
    )
    SELECT 
            SUBSTR(AA.RLVT_YM, 1, 4)||'년 '||SUBSTR(AA.RLVT_YM, 5, 2) || '월'                  AS  GIVE_YM
        ,   SUBSTR(AA.APRV_YMD, 1, 4)||'년 '||SUBSTR(AA.APRV_YMD, 5, 2) || '월'                  AS  APRV_YM
        ,   AA.OVTIME_WORK_SHAPE_SE_CD
        ,   AA.EXCESS_WORK_HR
        ,   FLOOR(AA.EXCESS_WORK_HR)    AS  INJUNG
        ,   AA.PENSN_SUM_AMT
        ,   AA.APRV_YN  
    FROM
            ZZ
        ,   AYC370      AA      /* 시간외근무수당 */
    WHERE   1=1
    AND AA.CONSTT_ID   =   ZZ.USER_ID
    AND AA.RLVT_YM      BETWEEN     ZZ.YYYY||'01'
                        AND         ZZ.YYYYMM      

    </select>
    
    <select id="selectOvtiWorkEtxpyAplyList4" parameterType="HashMap" resultType="HashMap">
    WITH    ZZ  AS
    (
            SELECT
                    #{YYYYMM}       AS  YYYYMM
                    , #{USER_ID}      AS  USER_ID
            FROM
                    DUAL
    )
    SELECT 
            COUNT(*)    CCNT
    FROM
            ZZ
        ,   AYC370      AA      /* 시간외근무수당 */
    WHERE   1=1
        AND AA.RLVT_YM      =       ZZ.YYYYMM
        AND AA.CONSTT_ID    =       ZZ.USER_ID

    </select>
    
    <insert id="insertOvtiWorkEtxpyAply" parameterType="HashMap" >
    /* 
     * SQL-ID : isry.couns.taskwksprt.etxpyaplyandinq.mapper.NgtmWorkEtxpyAplyMapper.insertNgtmWorkEtxpyAply : 저장 
     */
        INSERT 
        INTO AYC370 
        (
			 RLVT_YM
			 , CONSTT_ID
			 , OVTIME_WORK_SHAPE_SE_CD
			 , EXCESS_WORK_HR
			 , PENSN_RCGNTN_HR
			 , PENSN_SUM_AMT
			 , APRV_YN
			 , RM_CN
			 , APRV_YMD
			 , FRST_RGTR_ID
			 , FRST_REG_DT
			 , LAST_MDFR_ID
			 , LAST_MDFCN_DT
		) 
		VALUES 
		(
