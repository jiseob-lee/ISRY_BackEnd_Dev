<mapper namespace="isry.sample.mapper.Sample2Mapper">

    <update id="updateWrdPhone" parameterType="String">
    <![CDATA[
        /**/
        
        UPDATE SCA100
        
        SET 
            WRD_TELNO = '021112222'
            
        WHERE ENFSN_NO = (SELECT ENFSN_NO FROM SAA200 WHERE USER_ID = #{USER_ID})
        
    ]]>
    </update>
    
</mapper>