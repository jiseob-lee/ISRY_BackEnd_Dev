<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="isry.sample.mapper.TstBoardDevMapper2">

	<select id="selectSysDate" parameterType="HashMap"
		resultType="String">
		<choose>
			<when test="STR_FORMAT != null and STR_FORMAT != ''">
				SELECT TO_CHAR(SYSDATE, #{STR_FORMAT}) AS CURT_DT
			</when>
			<otherwise>
				SELECT TO_CHAR(SYSDATE, 'YYYYMMDD') AS CURT_DT
			</otherwise>
		</choose>
       <![CDATA[
            FROM DUAL
       ]]>
	</select>

	<select id="getTotalCount" resultType="String">
		/* QueryId : "getTotalCount" */
        <![CDATA[
        SELECT  COUNT(*)  
          FROM  CMN_TMP_BOARD        
        ]]>
	</select>

	<select id="selectBoardList" resultType="HashMap">
		/* QueryId : "selectBoardList" */
        <![CDATA[
        SELECT  BRD_SEQ
              , TIT
              , CONT
              , ATTC_FILE_NO
              , TO_CHAR(WRI_DT, 'YYYY-MM-DD') as WRI_DT
              , WRI_NM              
          FROM CMN_TMP_BOARD CTB
         WHERE 1=1
          ]]>
		ORDER BY BRD_SEQ DESC
	</select>

</mapper>