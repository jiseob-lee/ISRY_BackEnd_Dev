<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper
	namespace="isry.sample.mapper.TstGridMapper">

	<select id="selectSampleList" parameterType="HashMap"
		resultType="HashMap">
		<![CDATA[
		SELECT 
				ID, NAME, DESCRIPTION, USE_YN, REG_USER
		  FROM SAMPLE REG
		 WHERE 1=1
		  ]]>
		<if test="NAME != null and NAME != ''">
			AND NAME LIKE '%' || #{NAME} || '%'
		</if>
		ORDER BY ID ASC
	</select>

	<insert id="insertSample" parameterType="HashMap">
		INSERT INTO SAMPLE(
		ID
		<if test="NAME != null and NAME != ''">
			, NAME
		</if>
		<if test="DESCRIPTION != null and DESCRIPTION != ''">
			, DESCRIPTION
		</if>
		<if test="USE_YN != null and USE_YN != ''">
			, USE_YN
		</if>
		<if test="REG_USER != null and REG_USER != ''">
			, REG_USER
		</if>
		)VALUES(
		#{ID}
		<if test="NAME != null and NAME != ''">
			, #{NAME}
		</if>
		<if test="DESCRIPTION != null and DESCRIPTION != ''">
			,
			#{DESCRIPTION}
		</if>
		<if test="USE_YN != null and USE_YN != ''">
			, #{USE_YN}
		</if>
		<if test="REG_USER != null and REG_USER != ''">
			, #{REG_USER}
		</if>
		)
	</insert>

	<update id="updateSample" parameterType="HashMap">
		UPDATE SAMPLE
		<set>
			<if test="NAME != null">
				NAME = #{NAME},
			</if>
			<if test="DESCRIPTION != null">
				DESCRIPTION = #{DESCRIPTION},
			</if>
			<if test="USE_YN != null">
				USE_YN = #{USE_YN},
			</if>
			<if test="REG_USER != null">
				REG_USER = #{REG_USER},
			</if>
		</set>
		WHERE ID = #{ID__origin}
	</update>


	<delete id="deleteSample" parameterType="HashMap">
		DELETE
		FROM SAMPLE
		WHERE ID = #{ID__origin}
	</delete>
</mapper>